# Copy to .env.local and fill in

# API address used in the browser. A full URL locally, or "/backend" when the
# site proxies the API (see BACKEND_URL).
NEXT_PUBLIC_BASE_URL=http://localhost:3070

# Optional: real API address for the /backend proxy (e.g. on Vercel when the API has no https)
# BACKEND_URL=http://your-server-ip:3070

# Public address of this website (share previews, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3004
